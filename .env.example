# SENTINEL-X Environment Configuration
# Copy this to .env and fill in real values
# NEVER commit .env to Git

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=postgresql+psycopg2://sentinelx:sentinelx_dev@localhost:5432/sentinelx
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ============================================================
# REDIS (for Celery task queue)
# ============================================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ============================================================
# SECURITY SECRETS (generate secure random values for each)
# Example: python3 -c "import secrets; print(secrets.token_hex(32))"
# ============================================================
JWT_SECRET=CHANGE_ME_generate_a_secure_random_64_char_hex_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Fernet symmetric encryption for sensitive config values stored in DB
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_generate_a_fernet_key

# ============================================================
# GITHUB APP / OAUTH
# ============================================================
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# OAuth callback URL registered in GitHub App settings
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback

# ============================================================
# AI - OpenRouter
# ============================================================
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3-haiku
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=SENTINEL-X
OPENROUTER_MAX_TOKENS=2000
OPENROUTER_TIMEOUT_SECONDS=60

# ============================================================
# SCANNER TOOL PATHS (auto-detected if on PATH)
# ============================================================
SEMGREP_PATH=semgrep
GITLEAKS_PATH=gitleaks
SYFT_PATH=syft
GRYPE_PATH=grype
TRIVY_PATH=trivy
ZAP_API_URL=http://localhost:8080

# ============================================================
# APPLICATION SETTINGS
# ============================================================
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Assessment workspace base path (must NOT be on the control plane)
ASSESSMENT_WORKSPACE_BASE=/tmp/sentinelx/workspaces
ASSESSMENT_WORKSPACE_MAX_AGE_HOURS=24

# Worker concurrency
WORKER_CONCURRENCY=2
SCANNER_TIMEOUT_SECONDS=300
RUNTIME_PROVISIONING_TIMEOUT_SECONDS=120
DYNAMIC_TEST_TIMEOUT_SECONDS=180

# Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=10

# ============================================================
# FRONTEND
# ============================================================
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=SENTINEL-X
VITE_WS_URL=ws://localhost:8000
