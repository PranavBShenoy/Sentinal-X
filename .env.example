# SENTINEL-X Environment Configuration
# Copy this to .env and fill in real values
# NEVER commit .env to Git

# ============================================================
# DATABASE
# ============================================================
# Compose database identity; use distinct credentials outside local development.
POSTGRES_USER=sentinelx
POSTGRES_PASSWORD=CHANGE_ME_use_a_unique_database_password
POSTGRES_DB=sentinelx
# SQLAlchemy connection used by the API, worker, and migration job.
DATABASE_URL=postgresql+psycopg2://sentinelx:CHANGE_ME_use_a_unique_database_password@localhost:5432/sentinelx
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ============================================================
# REDIS (for Celery task queue)
# ============================================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ============================================================
# SECURITY SECRETS (generate secure random values for each)
# Example: python3 -c "import secrets; print(secrets.token_hex(32))"
# ============================================================
JWT_SECRET=CHANGE_ME_generate_a_secure_random_64_char_hex_string
# Compatibility alias used by the current Compose environment mapping.
JWT_SECRET_KEY=CHANGE_ME_generate_a_secure_random_64_char_hex_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Fernet symmetric encryption for sensitive config values stored in DB
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_generate_a_fernet_key

# ============================================================
# GITHUB APP / OAUTH
# ============================================================
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# OAuth callback URL registered in GitHub App settings
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback

# ============================================================
# AI - OpenRouter
# ============================================================
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3-haiku
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=SENTINEL-X
OPENROUTER_MAX_TOKENS=2000
OPENROUTER_TIMEOUT_SECONDS=60

# ============================================================
# RUNTIME BROKER (constrained Docker policy enforcement)
# ============================================================
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
BROKER_API_KEY=CHANGE_ME_generate_a_secure_random_64_char_hex_string
BROKER_AUTH_REQUIRED=true
BROKER_URL=http://localhost:8001
BUILD_NETWORK_MODE=none
BROKER_MEMORY_LIMIT=512m
BROKER_CPUS=1.0
BROKER_PIDS_LIMIT=100
BROKER_TMPFS_SIZE=64m
BROKER_MAX_CONCURRENT_BUILDS=2

# ============================================================
# CONTROL PLANE → EXECUTION PLANE AUTHORIZATION
# ============================================================
# Keep Ed25519 private signing material out of source control and mount it as
# a protected secret. The public key is safe to mount read-only on the host.
RUNTIME_MODE=remote
RUNTIME_URL=https://127.0.0.1:8443
JOB_TOKEN_PRIVATE_KEY_PATH=/run/secrets/job_token_private_key
JOB_TOKEN_PUBLIC_KEY_PATH=/etc/runtime_host/public_key.pem
# Host-side file Compose reads into its private-key secret.
JOB_TOKEN_PRIVATE_KEY_FILE=./runtime_host/certs/client/job_signing_private.pem
RUNTIME_CLIENT_CERT=./runtime_host/certs/client/client.crt
RUNTIME_CLIENT_KEY=./runtime_host/certs/client/client.key
RUNTIME_CA_CERT=./runtime_host/certs/client/server_ca.crt

# ============================================================
# RUNTIME HOST mTLS (Nginx terminator)
# ============================================================
# The shared proxy token is provided to both services via a Docker secret.
# Create a protected host file (never commit it):
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))" \
#     > runtime_host/certs/proxy_token
#   chmod 600 runtime_host/certs/proxy_token
# Requirements: at least 32 characters, only A-Z a-z 0-9 _ -, and no
# CHANGE_ME/placeholder values. For non-Compose deployments either set
# RUNTIME_HOST_PROXY_TOKEN_FILE or RUNTIME_HOST_PROXY_TOKEN (env fallback).
RUNTIME_HOST_PROXY_TOKEN_SECRET_FILE=./runtime_host/certs/proxy_token
RUNTIME_HOST_AUDIENCE=runtime-host
# Runtime Host verifies job tokens and client certificates using public CA material only.
RUNTIME_HOST_PUBLIC_KEY_PATH=/etc/runtime_host/public_key.pem
RUNTIME_HOST_CLIENT_CA_PATH=/etc/runtime_host/client_ca.crt
RUNTIME_HOST_PROXY_TOKEN_FILE=/run/secrets/runtime_host_proxy_token
RUNTIME_HOST_PROXY_TOKEN=
RUNTIME_HOST_ISSUER=sentinelx-authorization
RUNTIME_HOST_PORT=8443
# Comma-separated HTTPS origins allowed for artifact downloads.
RUNTIME_ARTIFACT_ORIGINS=https://artifacts.example.com
# Set one private advertised IP or DNS hostname; production has no loopback fallback.
RUNTIME_HOST_ADVERTISED_IP=
ADVERTISED_HOSTNAME=
RUNTIME_HOST_BIND_IP=
SENTINELX_NONCE_STORE_PATH=/var/lib/runtime_host/nonces.db
# Runtime Host connects to the dedicated DinD daemon over a private network.
DOCKER_HOST=tcp://runtime_engine:2375
DOCKER_TLS_CERTDIR=
# Container paths. Individual read-only file mounts are configured in
# docker-compose.yml; the CA private keys are never mounted.
# Backend also requires RUNTIME_HOST_CLIENT_CA_PATH and mounts only:
#   runtime_host/certs/public_key.pem
#   runtime_host/certs/server/client_ca.crt
NGINX_SERVER_CERT=/etc/nginx/tls/server.crt
NGINX_SERVER_KEY=/etc/nginx/tls/server.key
NGINX_CLIENT_CA=/etc/nginx/tls/client_ca.crt
# Optional CRL, mounted from runtime_host/certs/crl. When set, the file must
# exist and be a valid CRL; startup fails closed otherwise. Set
# NGINX_REQUIRE_CRL=true to require one.
NGINX_CLIENT_CRL=
NGINX_REQUIRE_CRL=false
NGINX_VERIFY_DEPTH=2
NGINX_RUNTIME_DIR=/etc/nginx/runtime
NGINX_UPSTREAM=http://runtime_host:8443

# ============================================================
# SCANNER TOOL PATHS (auto-detected if on PATH)
# ============================================================
SEMGREP_PATH=semgrep
GITLEAKS_PATH=gitleaks
SYFT_PATH=syft
GRYPE_PATH=grype
TRIVY_PATH=trivy
ZAP_API_URL=http://localhost:8080
OSV_PATH=osv-scanner
SEMGREP_RULES_PATH=./rules/semgrep/default_rules.json

# ============================================================
# APPLICATION SETTINGS
# ============================================================
APP_ENV=development
# Backwards-compatible alias; APP_ENV is the canonical environment selector.
ENVIRONMENT=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
TRUSTED_PROXIES=127.0.0.1,::1
RATE_LIMIT_ENABLED=true

# Assessment workspace base path (must NOT be on the control plane)
ASSESSMENT_WORKSPACE_BASE=/tmp/sentinelx/workspaces
ASSESSMENT_WORKSPACE_MAX_AGE_HOURS=24

# Worker concurrency
WORKER_CONCURRENCY=2
SCANNER_TIMEOUT_SECONDS=300
RUNTIME_PROVISIONING_TIMEOUT_SECONDS=120
DYNAMIC_TEST_TIMEOUT_SECONDS=180

# Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=10

# ============================================================
# FRONTEND
# ============================================================
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=SENTINEL-X
VITE_WS_URL=ws://localhost:8000
