# Dockerfile for SENTINEL-X Execution Worker with security scanners
FROM python:3.11-slim as builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir .

FROM python:3.11-slim as runner

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    git \
    libpango-1.0-0 \
    libharfbuzz0b \
    libpangoft2-1.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Match the API's non-root identity so both containers can safely share the
# workspace and report volumes. Worker scanner caches are writable by this user.
RUN groupadd -r sentinelx && useradd -r -g sentinelx -m -s /usr/sbin/nologin sentinelx
ENV HOME=/home/sentinelx \
    XDG_CACHE_HOME=/home/sentinelx/.cache \
    GRYPE_DB_CACHE_DIR=/home/sentinelx/.cache/grype

# Install security scanner binaries
# Syft
RUN curl -sSfL https://raw.githubusercontent.com/anchore/syft/main/install.sh | sh -s -- -b /usr/local/bin
# Grype updates its vulnerability database when a scan runs. Keep the cache
# writable under HOME rather than baking a large, quickly aging database into
# every worker image.
RUN curl -sSfL https://raw.githubusercontent.com/anchore/grype/main/install.sh | sh -s -- -b /usr/local/bin
# Trivy
RUN curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh | sh -s -- -b /usr/local/bin
# Gitleaks (pinned release; verify the official release checksum before install)
ARG GITLEAKS_VERSION=8.30.1
RUN set -eu; \
    case "$(uname -m)" in \
      x86_64) GITLEAKS_ARCH=x64 ;; \
      aarch64|arm64) GITLEAKS_ARCH=arm64 ;; \
      *) echo "Unsupported Gitleaks build architecture: $(uname -m)" >&2; exit 1 ;; \
    esac; \
    GITLEAKS_ASSET="gitleaks_${GITLEAKS_VERSION}_linux_${GITLEAKS_ARCH}.tar.gz"; \
    curl -sSfL "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/${GITLEAKS_ASSET}" -o "/tmp/${GITLEAKS_ASSET}"; \
    curl -sSfL "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_checksums.txt" \
      | grep " ${GITLEAKS_ASSET}$" | (cd /tmp && sha256sum --check --status); \
    tar -xzf "/tmp/${GITLEAKS_ASSET}" -C /usr/local/bin gitleaks; \
    chmod 0755 /usr/local/bin/gitleaks; \
    /usr/local/bin/gitleaks version; \
    rm "/tmp/${GITLEAKS_ASSET}"
# OSV-Scanner (v2.7.1) & offline database hydration
RUN curl -sSL -o /usr/local/bin/osv-scanner https://github.com/google/osv-scanner/releases/download/v2.7.1/osv-scanner_linux_amd64 && \
    chmod +x /usr/local/bin/osv-scanner && \
    mkdir -p /home/sentinelx/.cache/osv-scalibr/PyPI /home/sentinelx/.cache/grype && \
    curl -sSL -o /home/sentinelx/.cache/osv-scalibr/PyPI/all.zip https://osv-vulnerabilities.storage.googleapis.com/PyPI/all.zip

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Keep Semgrep's rapidly evolving CLI dependencies isolated from the API/worker
# environment so they cannot shadow the application's pinned Python packages.
RUN python -m venv /opt/semgrep && \
    /opt/semgrep/bin/pip install --no-cache-dir "semgrep==1.185.0" && \
    ln -sf /opt/semgrep/bin/semgrep /usr/local/bin/semgrep && \
    /usr/local/bin/semgrep --version

COPY app /app/app
COPY migrations /app/migrations
COPY alembic.ini /app/alembic.ini

RUN mkdir -p /var/lib/sentinelx/workspaces /var/lib/sentinelx/reports && \
    mkdir -p /home/sentinelx/.semgrep && \
    chown -R sentinelx:sentinelx /var/lib/sentinelx /home/sentinelx/.cache /home/sentinelx/.semgrep

USER sentinelx

CMD ["celery", "-A", "app.workers.celery_app", "worker", "--loglevel=info", "--concurrency=2"]
