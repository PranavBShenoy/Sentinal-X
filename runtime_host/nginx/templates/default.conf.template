# Trusted mTLS terminator for the Runtime Host.
# Rendered by /docker-entrypoint.d/20-envsubst-on-templates.sh.
server {
    listen ${NGINX_LISTEN_PORT} ssl;
    server_name ${NGINX_SERVER_NAME};

    # Client certificate trust configuration. No system CA fallback exists:
    # only the explicitly configured CA bundle is trusted.
    ssl_certificate     ${NGINX_SERVER_CERT};
    ssl_certificate_key ${NGINX_SERVER_KEY};
    ssl_client_certificate ${NGINX_CLIENT_CA};
    ssl_verify_client on;
    ssl_verify_depth ${NGINX_VERIFY_DEPTH};

    # Modern TLS only.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5:!3DES;
    ssl_prefer_server_ciphers off;
    ssl_ecdh_curve X25519:secp256r1;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 5m;
    ssl_session_tickets off;

    # Optional CRL. The entrypoint writes this snippet only when a CRL is
    # configured and readable; when CRL is required but missing, startup fails.
    include ${NGINX_RUNTIME_DIR}/crl*.conf;

    # Trusted-proxy token. The entrypoint writes this file from a protected
    # secret at startup so the token is not embedded in the rendered template.
    include ${NGINX_RUNTIME_DIR}/token.conf;

    location / {
        proxy_pass ${NGINX_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # Strip caller-supplied certificate identity headers. Only the values
        # derived from the certificate Nginx verified in the TLS handshake are
        # forwarded to the backend.
        proxy_set_header X-SSL-Client-Cert "";
        proxy_set_header X-SSL-Client-Fingerprint "";
        proxy_set_header X-Client-Fingerprint "";
        proxy_set_header X-Client-Cert-Fingerprint "";
        proxy_set_header X-Client-Cert-SHA256 "";

        # Verified identity. $ssl_client_escaped_cert is the URL-encoded PEM of
        # the client certificate Nginx validated against ssl_client_certificate.
        # The Runtime Host computes the SHA-256 fingerprint over the DER bytes.
        proxy_set_header X-Client-Cert $ssl_client_escaped_cert;
        proxy_set_header X-Client-Subject $ssl_client_s_dn;

        # Trusted-proxy token: prevents direct callers from impersonating the
        # proxy even if they reach the backend network. The value comes from
        # the protected token file written by the entrypoint, never from the
        # rendered configuration.
        proxy_set_header X-Runtime-Proxy-Token $runtime_proxy_token;

        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        client_max_body_size 16m;
    }
}
