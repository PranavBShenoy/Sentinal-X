# Server Configuration
PORT=5000
NODE_ENV=development

# Database Mode
# Set to 'aws' to connect to real AWS DynamoDB
# Set to 'local' for local development (uses local persistent JSON file / in-memory store mirroring DynamoDB)
# Set to 'dynamodb-local' if running DynamoDB Local Docker container (endpoint: http://localhost:8000)
DB_MODE=local

# AWS Configuration (Used when DB_MODE=aws or when using IAM Role on EC2)
AWS_REGION=us-east-1
# Leave keys empty if running on EC2 with an attached IAM Role
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# DynamoDB Table Names
DYNAMODB_TABLE_PARKING_SLOTS=ParkingSlots
DYNAMODB_TABLE_BOOKINGS=Bookings
DYNAMODB_TABLE_DETECTION_HISTORY=DetectionHistory

# DynamoDB Local Endpoint (if DB_MODE=dynamodb-local)
DYNAMODB_ENDPOINT=http://localhost:8000

# Authentication / Security
ADMIN_API_KEY=admin-secret-key-smart-parking-2026
JWT_SECRET=smart-parking-jwt-token-secret-key

# Simulation Settings
SIMULATION_INTERVAL_MS=5000
